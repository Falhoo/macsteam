@@ -8,6 +8,18 @@
 # hook_launch.c passes the launch options through a shell before this script runs, matching
 # Linux Steam. A NAME=value option placed ahead of %command% is an environment variable,
 # and anything after %command% is a launch argument passed to the game.
+# The first argument is the game executable. Keep it whole: joining the arguments
+# with "$*" loses where a path with spaces ends, and the OnlineFix scan below then
+# reads only "How to Fish" from "/…/How to Fish/How to Fish.exe" and finds no
+# loader beside it.
+np_launch_exe=""
+for np_arg in "$@"; do
+  case "$np_arg" in
+    *=*) continue ;;
+    *.[eE][xX][eE]) np_launch_exe="$np_arg"; break ;;
+  esac
+done
+[ -n "$np_launch_exe" ] || np_launch_exe="${1:-}"
 launch_args="$*"
 
 case "$verb" in
